{
  "schema": "vietflex-basemaps/0.4",
  "default": "simple",
  "architecture": "plugin-adapter",
  "basemaps": [
    {
      "id": "simple",
      "name": "Vietflex Simple",
      "kind": "vector-style",
      "provider": "OpenFreeMap",
      "source": "https://tiles.openfreemap.org/styles/positron",
      "capabilities": [
        "vector",
        "labels",
        "lightweight"
      ]
    },
    {
      "id": "dark",
      "name": "Vietflex Dark",
      "kind": "vector-style",
      "provider": "OpenFreeMap",
      "source": "https://tiles.openfreemap.org/styles/dark",
      "capabilities": [
        "vector",
        "labels",
        "dark"
      ]
    },
    {
      "id": "terrain",
      "name": "Vietflex Terrain / Topo",
      "kind": "terrain-dem",
      "provider": "Vietflex DEM",
      "manifest": "./terrain/manifest.json",
      "base_style": "https://tiles.openfreemap.org/styles/positron",
      "capabilities": [
        "raster-dem",
        "hillshade",
        "terrain-3d",
        "topographic",
        "self-hosted"
      ],
      "fallback": "simple",
      "replaceable_adapter": true
    },
    {
      "id": "satellite",
      "name": "Vietflex Satellite",
      "kind": "raster-xyz",
      "provider": "Esri World Imagery",
      "source": "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      "capabilities": [
        "raster",
        "satellite",
        "imagery"
      ],
      "replaceable_adapter": true
    },
    {
      "id": "vietflex",
      "name": "Vietflex Basemap",
      "kind": "raster-package",
      "provider": "Vietflex self-hosted raster",
      "manifest": "./basemaps/vietflex/manifest.json",
      "capabilities": [
        "raster",
        "administrative",
        "offline-ready",
        "self-hosted"
      ],
      "fallback": "simple",
      "replaceable_adapter": true
    },
    {
      "id": "tedp",
      "name": "Vietflex TEDP",
      "kind": "raster-xyz",
      "provider": "TEDP trực tuyến",
      "source": "https://tedp.vn/api/map/proxy-tile/{z}/{x}/{y}",
      "tile_size": 256,
      "minzoom": 3,
      "maxzoom": 18,
      "attribution": "Nguồn ảnh nền: TEDP (tedp.vn)",
      "capabilities": [
        "raster",
        "administrative",
        "online"
      ],
      "replaceable_adapter": true
    },
    {
      "id": "vnmap",
      "name": "VNMap Core",
      "kind": "vnmap-core",
      "provider": "Vietflex Core",
      "manifest": "./basemaps/vnmap-core/manifest.json",
      "capabilities": [
        "vector",
        "mvt",
        "pmtiles-ready",
        "administrative",
        "transport",
        "poi",
        "building",
        "offline-ready",
        "self-hosted-ready",
        "provider-neutral"
      ],
      "fallback": "simple",
      "replaceable_adapter": true,
      "core_contract": true
    }
  ],
  "principles": [
    "basemap-is-not-core",
    "provider-is-replaceable",
    "ui-reads-registry",
    "attribution-is-provider-aware",
    "terrain-data-is-self-managed",
    "terrain-falls-back-without-breaking-map",
    "raster-package-is-self-hosted",
    "binary-map-assets-live-outside-core",
    "vnmap-core-is-provider-neutral",
    "vnmap-core-production-requires-provenance"
  ]
}
