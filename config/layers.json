{
  "schema": "vietflex-layer-registry/1.0",
  "contract": "../schema/vietflex-layer.schema.json",
  "principles": [
    "layer-is-not-core",
    "registry-is-source-of-truth",
    "adapter-is-replaceable",
    "dataset-metadata-is-required",
    "ui-does-not-hardcode-layers"
