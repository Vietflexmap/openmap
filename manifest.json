{
  "name": "VIETFLEX CORE TECH",
  "version": "0.5.0",
  "architecture": "ports-and-adapters",
  "description_vi": "Lõi công nghệ nền dùng chung cho bản đồ, dữ liệu không gian, sự kiện, ngữ cảnh không gian, định tuyến, theo dõi, tri thức, AI và IoT.",
  "core": {
    "schema": true,
    "capability": true,
    "event": true,
    "domain_services": true,
    "data": true,
    "spatial": true,
    "temporal": true,
    "spatial_context": true,
    "route": true,
    "watch": true,
    "knowledge": true
  },
  "contracts": {
    "feature": "schema/vietflex-feature.schema.json",
    "event": "schema/vietflex-event.schema.json",
    "dataset": "schema/vietflex-dataset.schema.json",
    "context": "schema/vietflex-context.schema.json",
    "route": "schema/vietflex-route.schema.json",
    "watch": "schema/vietflex-watch.schema.json",
    "knowledge": "schema/vietflex-knowledge.schema.json",
    "capability": "schema/vietflex-capability.schema.json",
    "plugin": "schema/vietflex-plugin.schema.json",
    "layer": "schema/vietflex-layer.schema.json"
  },
  "runtime_local_capabilities": [
    "spatial.distance",
    "spatial.nearby",
    "spatial.intersects",
    "context.nearby",
    "context.on-route",
    "context.risk",
    "routing.analyze-hazards",
    "watch.create",
    "watch.evaluate",
    "knowledge.query",
    "knowledge.risk-profile",
    "event.publish"
  ],
  "adapters": [
    "PostGIS",
    "GPKG",
    "PMTiles",
    "COG",
    "Object Storage",
    "MapLibre",
    "Valhalla",
    "Photon",
    "MQTT",
    "SSE",
    "GeoAI",
    "Device Drivers"
  ],
  "ports": {
    "cdn": {
      "status": "active",
      "role": "static SDK/schema/style/plugin/manifest distribution"
    },
    "api": {
      "status": "planned",
      "role": "HTTP capability gateway"
    },
    "mcp": {
      "status": "planned",
      "role": "AI/agent capability gateway"
    },
    "sse": {
      "status": "planned",
      "role": "server-to-client realtime event gateway"
    },
    "mqtt": {
      "status": "planned",
      "role": "IoT/device realtime gateway"
    }
  },
  "sdk_plugins": {
    "javascript": "active",
    "plugin_contract": "defined",
    "python": "planned",
    "mobile": "planned"
  },
  "schema_version": "0.5.0",
  "dataset_version": null,
  "compatibility": [
    "0.4.x",
    "0.3.x aliases"
  ],
  "principles": [
    "stable-domain-core",
    "schema-first",
    "capability-first",
    "event-first",
    "ports-and-adapters",
    "backend-neutral",
    "plugin-extensible",
    "versioned-data",
    "provenance-and-qa",
    "temporal-validity",
    "spatial-context",
    "vietnamese-first"
  ],
  "map_core": {
    "id": "vnmap",
    "name": "VNMap Core",
    "version": "0.1.0",
    "status": "bootstrap",
    "role": "provider-neutral Vietnam basemap/data-core profile",
    "sdk": "dist/vnmap-core.js",
    "manifest": "basemaps/vnmap-core/manifest.json",
    "domains": [
      "basemap",
      "transport",
      "poi",
      "building"
    ],
    "production_ready": false
  }
}
