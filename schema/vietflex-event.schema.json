{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietflexmap.github.io/openmap/schema/vietflex-event.schema.json",
  "title": "Vietflex Event",
  "type": "object",
  "required": ["event_id", "schema_version", "type", "time", "status"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string"},
    "type": {"type": "string", "minLength": 1},
    "geometry": {"type": ["object", "null"]},
    "severity": {"type": ["number", "string", "null"]},
    "status": {"type": "string", "enum": ["active", "resolved", "expired", "blocked", "unknown"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "time": {
      "type": "object",
      "required": ["received_at"],
      "properties": {
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_to": {"type": ["string", "null"], "format": "date-time"},
        "received_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    },
    "source": {"type": "object"},
    "asset_id": {"type": ["string", "null"]},
    "refs": {"type": "object"},
    "properties": {"type": "object"},
    "media": {"type": "array"},
    "dataset_version": {"type": ["string", "null"]},
    "provenance": {"type": "object"},
    "quality": {"type": "object"}
  },
  "additionalProperties": true
}
